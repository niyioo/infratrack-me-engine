SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=infratrack
DB_USER=infra
DB_PASSWORD=infra1234
DB_HOST=127.0.0.1
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
# Reverse proxies in front of Django (1 behind nginx/a load balancer). Used to read the
# real client IP for rate limits and citizen-report dedup; 0 trusts only REMOTE_ADDR.
NUM_PROXIES=0
# Citizen reports: distinct anonymous reporters within the window that raise project risk
CITIZEN_REPORT_WINDOW_DAYS=30
CITIZEN_REPORT_HIGH_THRESHOLD=3
CITIZEN_REPORT_CRITICAL_THRESHOLD=6
CITIZEN_REPORT_DAILY_LIMIT_PER_PROJECT=3
THROTTLE_CITIZEN_REPORT=10/hour
USE_X_FORWARDED_HOST=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False
ANALYTICS_PORTFOLIO_REFRESH_MINUTES=15
ANALYTICS_PROJECT_REFRESH_MINUTES=60
VITE_API_BASE_URL=http://127.0.0.1:8000/api
# Portfolio map tiles. Defaults to OpenStreetMap's public servers, whose usage
# policy doesn't allow heavy production traffic: point this at a self-hosted or
# commercial tile server for production, and set its attribution.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
# Report/export rate limit and how many citizen-report pins the map draws.
THROTTLE_REPORT_EXPORT=60/hour
MAP_MAX_CITIZEN_REPORTS=1000
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
VITE_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/public
OSGEO4W_BIN=
GDAL_DATA=
PROJ_LIB=
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=
