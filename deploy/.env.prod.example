# Copy to deploy/.env.prod, fill in, and keep it out of git (it holds secrets).

# ── Domains (DNS A/AAAA records must point at this server) ───────────────────
APP_DOMAIN=app.example.org
API_DOMAIN=api.example.org
PORTAL_DOMAIN=report.example.org
ACME_EMAIL=ops@example.org

# ── Django ───────────────────────────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_urlsafe(50))"
# Changing it later logs everyone out and resets citizen-report duplicate checks.
SECRET_KEY=
ALLOWED_HOSTS=api.example.org
CORS_ALLOWED_ORIGINS=https://app.example.org,https://report.example.org
CSRF_TRUSTED_ORIGINS=https://app.example.org,https://report.example.org
# One proxy (Caddy) sits in front of Django.
NUM_PROXIES=1
GUNICORN_WORKERS=3

# ── Database (used by both Postgres and Django) ──────────────────────────────
DB_NAME=infratrack
DB_USER=civitness
# python -c "import secrets; print(secrets.token_urlsafe(32))"
DB_PASSWORD=

# ── Map tiles (dashboard) ────────────────────────────────────────────────────
# Free key: https://carto.com/basemaps/apikey/ (restrict it to APP_DOMAIN).
VITE_CARTO_BASEMAP_KEY=
VITE_CARTO_BASEMAP_STYLE=voyager
