{
  "expo": {
    "name": "InfraTrack",
    "slug": "infratrack-mobile",
    "scheme": "infratrack",
    "version": "1.0.0",
    "icon": "./assets/app-icon.png",
    "newArchEnabled": true,
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.infratrack.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.infratrack.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "InfraTrack uses the camera for live evidence capture.",
        "NSLocationWhenInUseUsageDescription": "InfraTrack uses location to verify field evidence."
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-location",
      "expo-camera",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
