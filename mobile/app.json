{
  "expo": {
    "name": "BuildWitness",
    "slug": "buildwitness-mobile",
    "scheme": "buildwitness",
    "version": "1.0.0",
    "icon": "./assets/app-icon.png",
    "newArchEnabled": true,
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.buildwitness.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "versionCode": 1
    },
    "ios": {
      "bundleIdentifier": "com.buildwitness.app",
      "infoPlist": {
        "NSCameraUsageDescription": "BuildWitness uses the camera for live evidence capture.",
        "NSLocationWhenInUseUsageDescription": "BuildWitness uses location to verify field evidence.",
        "NSPhotoLibraryUsageDescription": "BuildWitness lets citizens attach an existing photo to an anonymous report."
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-location",
      "expo-camera",
      "expo-asset",
      "expo-font",
      "./plugins/withAndroidRelease"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
